  puntosInfo:
  - nombre: "GASTRONOM\xCDA"
    posicion: {x: 2.5, y: 6.5}
    area: "GASTRONOM\xCDA"
    texto: "En estas cocinas se forman los futuros chefs con pr\xE1ctica real."
    consejo: 'Consejo: en la cocina se entra con uniforme, gorro y manos limpias.'
  - nombre: Pasillo
    posicion: {x: 12.5, y: 3.5}
    area: PASILLO
    texto: "Este piso une a dos carreras muy pr\xE1cticas: cocina y salud."
    consejo: 'Consejo: en los laboratorios, la higiene y el orden son lo primero.'
  - nombre: LAB. MEDICINA
    posicion: {x: 15.5, y: 6.5}
    area: LAB. MEDICINA
    texto: "Aqu\xED se practican procedimientos de salud con equipos y maniqu\xEDes."
    consejo: 'Consejo: usa mandil y sigue las indicaciones del docente.'
  datosReserva:
  - nombre: "COCINA"
    posicion: {x: 0, y: 0}
    area: "COCINA"
    texto: "Las estaciones de cocina tienen hornallas, campanas y mesas de trabajo."
    consejo: "Consejo: nunca dejes una olla sola en el fuego."
  - nombre: "ENFERMERÍA"
    posicion: {x: 0, y: 0}
    area: "ENFERMERÍA"
    texto: "Aquí aprendes primeros auxilios y cuidado del paciente."
    consejo: "Consejo: lávate las manos antes y después de cada práctica."
